# Application settings
APP_NAME=Workforce Management AI API
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neon PostgreSQL connection (never commit real credentials)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional dedicated read-only role connection for AI agents
# If omitted, the backend derives a transaction-level READ ONLY connection from DATABASE_URL
READONLY_DATABASE_URL=

# SQLAlchemy connection pool & SSL settings
DB_SSL_MODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Agent orchestration mode: "legacy" (deterministic SQL + rule intent routing) or "tools" (multi-agent supervisor + domain specialist tool calling)
AGENT_MODE=tools

