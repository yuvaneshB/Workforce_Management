# Application settings
APP_NAME=Workforce Management AI API
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:4173,http://127.0.0.1:4173,*

# Neon PostgreSQL connection (never commit real credentials)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional dedicated read-only role connection for AI agents
# If omitted, the backend derives a transaction-level READ ONLY connection from DATABASE_URL
READONLY_DATABASE_URL=

# SQLAlchemy connection pool & SSL settings
DB_SSL_MODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Maximum reasoning and tool-calling loop iterations per agent execution
AGENT_MAX_STEPS=4

# Overall execution timeout in seconds for single-domain specialist agent runs
AGENT_TOTAL_TIMEOUT_SEC=60

# Overall execution timeout in seconds for cross-domain supervisor multi-agent orchestrations
AGENT_CROSS_DOMAIN_TIMEOUT_SEC=100

# Per-call LLM inference timeout in seconds
AGENT_LLM_TIMEOUT_SEC=30

# Request timeout in seconds for Domo conversational and analytical API calls
DOMO_TIMEOUT=30


